# Torim — copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# REQUIRED. The application connection.
#
# ⚠ This MUST be a non-superuser role without BYPASSRLS. Postgres silently skips
#   row-level security for superusers — no error, no warning, and every business
#   reads every other business's bookings. `npm run db:grant` creates the right
#   role; `npm run db:check-role` proves it.
DATABASE_URL=postgres://torim_app:change-me@localhost:5432/torim_dev

# Used only by `npm run migrate` and `npm run db:grant`, which need DDL rights.
# Leave unset in production; run migrations from a shell with it exported.
MIGRATE_DATABASE_URL=postgres://your-owner-role@localhost:5432/torim_dev

# What `npm run db:grant` creates.
APP_DB_ROLE=torim_app
APP_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Sessions and admin sign-in
# ---------------------------------------------------------------------------
# REQUIRED, minimum 32 characters. Seals the admin session cookie. There is no
# default: a guessable fallback would let anyone mint an owner session.
#   openssl rand -base64 32
SESSION_PASSWORD=

# REQUIRED for the business owner's Google sign-in. Without these there is no way
# into /admin at all — see "Google sign-in" in README.md for how to obtain them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED. Must match an Authorized redirect URI registered on the Google Cloud
# OAuth client byte for byte — scheme, host, port, path, no trailing slash. It is
# configuration and never derived from the incoming request, precisely so it cannot
# drift from what Google has on file. Change it to your real origin in production.
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# The public origin, used to build booking-management and calendar links. Set it in
# production.
#
# ⚠ Nothing fails or refuses to start when this is unset — each consumer falls back,
#   and two of the three fallbacks are wrong outside development:
#     * notification messages (src/lib/notify/messages.ts) fall back to a RELATIVE
#       "/manage/<token>", which is a dead link once it is in an email;
#     * the admin settings page shows the same relative path as the business's
#       shareable booking link;
#     * the .ics route falls back to the request's own forwarded host, which is
#       usually right but is whatever a proxy put in the header.
#   The failure mode is a broken link in front of a real customer, discovered by the
#   customer. Set it.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Deployment shape
# ---------------------------------------------------------------------------
# How many proxies sit in front of Torim. Default 1 — one load balancer / CDN /
# reverse proxy appending the address it observed to X-Forwarded-For.
#
# The public rate limiters key on the client address, and X-Forwarded-For is
# APPENDED to by each hop, so its left-most entry is whatever the client chose to
# send. clientAddress() therefore counts from the RIGHT, and this is how far.
#
#   0  = trust nothing in front; ignore the header entirely.
#   1  = one trusted proxy (the default, and the common case).
#   2+ = that many proxies, e.g. a CDN in front of a platform load balancer that
#        also appends.
#
# ⚠ Setting this HIGHER than your real hop count makes every IP-keyed rate limit
#   ineffective: the client controls how long the chain is, so it pads the header
#   until the counted-from-the-right index lands on a value it chose, then varies
#   that value per request for a fresh bucket every time. It fails open and it fails
#   silently. Guess LOW if you are unsure — too low merely collapses everyone into
#   one shared bucket. See SECURITY.md.
TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# Torim ships with no messaging provider and no account with anybody. Unset (or
# `none`) is the default and sends nothing at all — the owner-initiated WhatsApp
# links still work, because they open her own WhatsApp on her own device.
#
# Built in: `none`, `smtp`. A fork adds its own adapter with registerTransport()
# and names it here. An unrecognised value refuses to start — src/instrumentation.ts
# resolves the transport at boot and lets the throw escape, rather than letting the
# app run on silently sending nothing. See docs/NOTIFICATIONS.md.
TORIM_TRANSPORT=none

# Read ONLY when TORIM_TRANSPORT=smtp. Your own mail server, your own domain —
# there is no default host, because this project has no account with one.
# ⚠ TORIM_TRANSPORT=smtp with an empty SMTP_URL also refuses to start (same file).
SMTP_URL=
SMTP_FROM=

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Bearer token for the server-to-server ops endpoints that expose due notifications
# to an external transport (n8n or anything else). Server secret — never user-facing.
# Leave unset and the endpoints stay closed; the product works without them.
OPS_TOKEN=

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
# Point the suite at a throwaway database, separate from your dev one. Same
# superuser rule applies — but note `npm run db:check-role` reads DATABASE_URL only
# and never inspects this variable.
TEST_DATABASE_URL=postgres://torim_app:change-me@localhost:5432/torim_test

# ---------------------------------------------------------------------------
# Demo seed
# ---------------------------------------------------------------------------
# `npm run db:seed` is DESTRUCTIVE: it deletes and re-inserts every services /
# working-hours / closures / customers / bookings row belonging to the "demo"
# business. Its only guard is the shape of the database NAME — it refuses to run
# unless DATABASE_URL ends in "_dev" or "_test".
#
# ⚠ ALLOW_DESTRUCTIVE_SEED=1 switches that guard off. It is the single thing standing
#   between a mistyped or stale DATABASE_URL and destroying a real business's data,
#   with no way back. Leave it commented out. Do not set it in a shell profile, a
#   platform env, or anything that outlives the one command you meant it for.
# ALLOW_DESTRUCTIVE_SEED=1

# Makes an EXISTING signed-in user the owner of the demo business, so /admin shows the
# seeded data instead of sending you to /onboarding to create a second, empty business.
# Sign in at /login once first — this attaches an account, it cannot invent one (users
# are keyed on their Google subject id, never on email). Then:
#   SEED_OWNER_EMAIL=you@example.com npm run db:seed
# SEED_OWNER_EMAIL=
